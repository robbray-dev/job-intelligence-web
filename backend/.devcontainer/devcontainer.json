{
	"name": "Java",
	"image": "mcr.microsoft.com/devcontainers/java:3-21-bookworm",

	"features": {
		"ghcr.io/devcontainers/features/java:1": {
			"version": "none",
			"installMaven": "true",
			"installGradle": "false"
		}
	},

	"forwardPorts": [8080],

	"postCreateCommand": "mvn dependency:resolve -B",

	"customizations": {
		"vscode": {
			"extensions": [
				"vscjava.vscode-java-pack",
				"vscjava.vscode-spring-boot-pack"
			]
		}
	},

	"runArgs": ["--env-file", ".devcontainer/devcontainer.env"]
}